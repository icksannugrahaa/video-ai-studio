# sandroid-ai-video — copy to .env and fill in.
# Generate a secret: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# WARNING: changing SAV_SECRET_KEY makes stored provider API keys unreadable.
SAV_SECRET_KEY=
SAV_ADMIN_USERNAME=admin
SAV_ADMIN_PASSWORD=
SAV_HOST=127.0.0.1
SAV_PORT=7300
# Data (SQLite + project files). Default: ./data
# SAV_DATA_DIR=/opt/sandroid-ai-video/data
# Render settings for the phone CPU (short side in px, fps, x264 preset)
SAV_RENDER_WIDTH=720
SAV_RENDER_FPS=30
SAV_FFMPEG_PRESET=veryfast
# Parallel clip generation when continuity is off
SAV_CLIP_CONCURRENCY=2
# Set 0 only when serving over plain http (local testing)
SAV_COOKIE_SECURE=1
